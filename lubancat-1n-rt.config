# Minimal build seed for the LubanCat 1N RT image (this branch).
#
# Usage:
#   cp lubancat-1n-rt.config .config
#   make defconfig
#   make -j$(nproc)
#
# EXTRA_IMAGE_NAME="rt" marks the PREEMPT_RT kernel (enabled in
# target/linux/rockchip/armv8/config-6.12) in the output filenames:
#   openwrt-rt-rockchip-armv8-embedfire_lubancat-1n-*.img.gz
# IMAGEOPT is required for the EXTRA_IMAGE_NAME prompt to survive
# make defconfig.
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_embedfire_lubancat-1n=y
CONFIG_PACKAGE_luci=y
CONFIG_IMAGEOPT=y
CONFIG_EXTRA_IMAGE_NAME="rt"

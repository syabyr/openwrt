# Grow the root partition to fill the whole eMMC/SD (ext4 images only).
# Ported from vendor rootfs (etc/expand-root.sh, 70-rootpt-resize).
# Kept (not auto-deleted) via exit 1 + /etc/sysupgrade.conf, guarded by markers.
[ "$(awk '$2=="/"{print $3}' /proc/mounts)" = "ext4" ] || exit 0

if [ ! -e /etc/rootpt-resize ] \
&& type parted > /dev/null \
&& lock -n /var/lock/root-resize
then
ROOT_BLK="$(readlink -f /sys/dev/block/"$(awk -e \
'$9=="/dev/root"{print $3}' /proc/self/mountinfo)")"
ROOT_DISK="/dev/$(basename "${ROOT_BLK%/*}")"
ROOT_PART="${ROOT_BLK##*[^0-9]}"
parted -f -s "${ROOT_DISK}" \
resizepart "${ROOT_PART}" 100%
mount_root done
touch /etc/rootpt-resize
reboot
fi
exit 1

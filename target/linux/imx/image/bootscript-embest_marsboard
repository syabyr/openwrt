echo "Embest MarS Board OpenWrt Boot script"

setenv console console=ttymxc1,115200

# devnum is set by distro boot to the scanned device (eMMC = 1 here);
# default to 1 so the script also works when run manually
if test -z "${devnum}"; then setenv devnum 1; fi
setenv rootpart 2
part uuid mmc ${devnum}:${rootpart} uuid

setenv root root=PARTUUID=${uuid} rootwait
setenv bootargs ${console} ${root}

mmc dev ${devnum}
if load mmc ${devnum}:1 ${kernel_addr_r} /uImage; then
	if load mmc ${devnum}:1 ${fdt_addr_r} /imx6q-marsboard.dtb; then
		bootz ${kernel_addr_r} - ${fdt_addr_r}
	else
		echo "Error loading device-tree"
	fi
else
	echo "Error loading kernel image"
fi

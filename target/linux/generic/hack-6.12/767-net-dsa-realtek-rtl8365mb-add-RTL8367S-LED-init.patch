+	/* Program LED mode on RTL8367S (parallel, all ports in group 0) */
+	if (mb->chip_info->chip_id == 0x6367 &&
+	    mb->chip_info->chip_ver == 0x00A0) {
+		ret = rtl8365mb_led_setup(priv);
+		if (ret)
+			dev_warn(priv->dev, "failed to set up LEDs: %d\n", ret);
+	}
+

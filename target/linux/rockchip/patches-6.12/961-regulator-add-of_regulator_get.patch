 	return ERR_PTR(-ENODEV);
 }
 
+/**
+ * of_regulator_get - get regulator via device tree lookup
+ * @dev: device used for dev_printk() messages
+ * @node: device node for regulator "consumer"
+ * @id: Supply name
+ *
+ * Return: pointer to struct regulator corresponding to the regulator producer,
+ *	   or PTR_ERR() encoded error number.
+ *
+ * This is intended for use by consumers that want to get a regulator
+ * supply directly from a device node. This will _not_ consider supply
+ * aliases. See regulator_dev_lookup().
+ */
+struct regulator *of_regulator_get(struct device *dev,
+				  struct device_node *node, const char *id)
+{
+	struct regulator_dev *r;
+	struct device_node *regnode;
+	char prop_name[64]; /* 64 is max size of property name */
+	int ret;
+
+	ret = _regulator_get_common_check(dev, id, NORMAL_GET);
+	if (ret)
+		return ERR_PTR(ret);
+
+	snprintf(prop_name, sizeof(prop_name), "%s-supply", id);
+	regnode = of_parse_phandle(node, prop_name, 0);
+	if (!regnode)
+		return ERR_PTR(-ENODEV);
+
+	r = of_find_regulator_by_node(regnode);
+	of_node_put(regnode);
+	if (!r) {
+		/*
+		 * We have a node, but there is no device.
+		 * assume it has not registered yet.
+		 */
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
+	return _regulator_get_common(r, dev, id, NORMAL_GET);
+}
+EXPORT_SYMBOL_GPL(of_regulator_get);
+
